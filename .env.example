# Canonical production origin, no trailing slash. Drives canonical, hreflang,
# sitemap, RSS, llms.txt and every JSON-LD @id.
# In CF Pages set this in Settings > Environment variables (the .env file is
# gitignored and never uploaded).
PUBLIC_SITE_URL=https://www.yourdomain.com

# --- Cloudflare Pages static-file budget guard ---
# Free plan: 20,000 files per deployment. Keep a 2,000-file headroom for
# _astro chunks and future assets.
PUBLIC_STATIC_FILE_BUDGET=18000
PUBLIC_PAGES_FILE_LIMIT=20000
# Paid plan (after setting PAGES_WRANGLER_MAJOR_VERSION=4 in CF project settings):
# PUBLIC_STATIC_FILE_BUDGET=95000
# PUBLIC_PAGES_FILE_LIMIT=100000

# Sitemap shard size. Google/Bing accept up to 50,000 URLs per file.
PUBLIC_SITEMAP_URL_LIMIT=45000

# Articles exposed in the lightweight client-side search index.
PUBLIC_SEARCH_INDEX_LIMIT=500

# Articles per llms-full-N.txt part. Larger = fewer files in the deployment.
PUBLIC_LLMS_CHUNK_SIZE=100

# CF Pages build settings (not env vars consumed by the app):
#   Build command:             npm run build
#   Build output directory:    dist
#   Node version:              22  (.node-version is committed; also set NODE_VERSION=22)
