---
import ListingLayout from '../../../layouts/ListingLayout.astro';
import { PAGINATION } from '../../../config/site';
import { localePath, t } from '../../../i18n';
import { pageAlternates } from '../../../lib/links';
import { listByGroup } from '../../../lib/repository';
import { groupHref, parseGroupPage } from '../../../lib/routes';
import { groupStaticPaths } from '../../../lib/static-paths';
import { seriesBySlug } from '../../../lib/taxonomy';

export function getStaticPaths() {
  return groupStaticPaths('by-series');
}

const L = Astro.params.lang ?? 'en';
const parsed = parseGroupPage(Astro.params.slug)!;
const series = seriesBySlug.get(parsed.key)!;
const result = listByGroup('by-series', parsed.key, parsed.page, PAGINATION.articlesPerPage);
const href = groupHref(localePath(L, 'series', parsed.key));
const pageSegments = parsed.page > 1 ? ['page', String(parsed.page)] : [];
---

<ListingLayout
  lang={L}
  path={href(parsed.page)}
  title={series.name}
  description={series.description}
  eyebrow={series.eyebrow}
  cards={result.cards}
  page={parsed.page}
  totalPages={result.totalPages}
  total={result.total}
  href={href}
  alternates={pageAlternates(L, 'series', parsed.key, ...pageSegments)}
  crumbs={[
    { label: t(L, 'common.breadcrumbHome'), href: localePath(L) },
    { label: t(L, 'nav.series'), href: localePath(L, 'systems') },
    { label: series.name },
  ]}
/>
