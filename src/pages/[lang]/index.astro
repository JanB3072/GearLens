---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryTile from '../../components/cards/CategoryTile.astro';
import SeriesCard from '../../components/cards/SeriesCard.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { SITE } from '../../config/site';
import { CATEGORIES, SERIES } from '../../config/navigation';
import { categoryPath, localePath, localeStaticParams, t } from '../../i18n';
import { pageAlternates } from '../../lib/links';
import { getGroupCounts, getStats, listByDate } from '../../lib/repository';
import { authorBySlug } from '../../lib/taxonomy';
import { graph, itemListSchema, organizationSchema, websiteSchema } from '../../lib/schema';

export function getStaticPaths() {
  return localeStaticParams();
}

const { lang } = Astro.params;
const L = lang ?? 'en';
const latest = listByDate(1, 6).cards;
const categoryCounts = getGroupCounts('by-category');
const seriesCounts = getGroupCounts('by-series');
const stats = getStats() as { published: number; words: number; categories: Record<string, number> };

const jsonLd = graph([
  organizationSchema(),
  websiteSchema(L),
  itemListSchema(latest, `${SITE.name} latest guides`),
]);

const numberFormat = new Intl.NumberFormat(L === 'de' ? 'de-DE' : 'en-US');
const formatNum = (n: number) => numberFormat.format(n);
const sweepAuthor = authorBySlug.get('maya-chen')?.name ?? 'Maya Chen';
const lastEdit = latest[0]?.updatedAt
  ? new Intl.DateTimeFormat(L === 'de' ? 'de-DE' : 'en-US', {
      month: 'short', day: 'numeric', timeZone: 'UTC',
    }).format(new Date(latest[0].updatedAt))
  : 'n/a';

const pillars = [
  { label: t(L, 'home.pillar1Label'), title: t(L, 'home.pillar1Title'), href: localePath(L, 'systems') },
  { label: t(L, 'home.pillar2Label'), title: t(L, 'home.pillar2Title'), href: categoryPath(L, 'home-theater') },
  { label: t(L, 'home.pillar3Label'), title: t(L, 'home.pillar3Title'), href: categoryPath(L, 'hi-fi-stereo') },
  { label: t(L, 'home.pillar4Label'), title: t(L, 'home.pillar4Title'), href: categoryPath(L, 'room-acoustics') },
];

const records = [
  { value: stats.published, suffix: '', title: t(L, 'home.recordGuides'), text: t(L, 'home.recordGuidesText') },
  { value: stats.words, suffix: '', title: t(L, 'home.recordWords'), text: t(L, 'home.recordWordsText') },
  { value: CATEGORIES.length, suffix: '', title: t(L, 'home.recordSections'), text: t(L, 'home.recordSectionsText') },
  { value: 100, suffix: '%', title: t(L, 'home.recordMirrors'), text: t(L, 'home.recordMirrorsText') },
];

// A deterministic in-room response shape: two room-mode dips, a gentle HF
// roll-off and small ripples. Same markup on every build, no random jumps.
const BAR_COUNT = 48;
const bars = Array.from({ length: BAR_COUNT }, (_, i) => {
  const x = i / (BAR_COUNT - 1);
  const ripple = Math.sin(x * Math.PI * 5) * 12 + Math.sin(x * Math.PI * 13) * 7;
  const tilt = 74 - x * 18;
  const d1 = (x - 0.32) / 0.05;
  const d2 = (x - 0.68) / 0.055;
  const dip = 30 * Math.exp(-(d1 * d1)) + 20 * Math.exp(-(d2 * d2));
  return Math.round(Math.max(10, Math.min(96, tilt + ripple - dip)));
});

const tickerItems = [
  `${t(L, 'home.tickerLatest')}: ${latest[0]?.title ?? SITE.name}`,
  `${formatNum(stats.published)} ${t(L, 'home.tickerGuides')}`,
  `${sweepAuthor} / ${t(L, 'home.tickerSweeps')}`,
  t(L, 'home.tickerMirrors'),
];
const scale = ['20', '50', '100', '200', '500', '1k', '2k', '5k', '10k', '20k'];
---

<BaseLayout
  lang={L}
  seo={{
    title: SITE.tagline,
    description: SITE.description,
    path: localePath(L),
    lang: L,
    alternates: pageAlternates(L),
    jsonLd,
    noappend: false,
  }}
>
  <section class="hero" data-glow>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">{t(L, 'home.heroEyebrow')}</span>
        <h1 class="display" data-hero-lines>
          <span class="hero-line" style="--line:0"><span>{t(L, 'home.heroTitleA')}</span></span>
          <span class="hero-line" style="--line:1"><span><em>{t(L, 'home.heroTitleB')}</em></span></span>
        </h1>
        <p class="lede">{t(L, 'home.heroBody')}</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href={localePath(L, 'systems')}>{t(L, 'home.heroPrimary')} <span class="arrow">↗</span></a>
          <a class="btn btn--ghost" href={localePath(L, 'categories')}>{t(L, 'home.heroSecondary')}</a>
        </div>
        <div class="hero-meta">
          <div><strong data-count={stats.published}>{formatNum(stats.published)}</strong><small>{t(L, 'home.recordGuides')}</small></div>
          <div><strong data-count={CATEGORIES.length}>{formatNum(CATEGORIES.length)}</strong><small>{t(L, 'nav.categories')}</small></div>
          <div><strong>{lastEdit}</strong><small>{t(L, 'article.updated')}</small></div>
        </div>
      </div>

      <div class="hero-scope">
        <div class="scope-head">
          <span>{t(L, 'home.scopeLabel')}</span>
          <span class="scope-dot" aria-hidden="true"></span>
        </div>
        <div class="scope-plot" aria-hidden="true">
          <div class="scope-bars">
            {bars.map((h, i) => <span class="scope-bar" style={`--h:${h}%;--i:${i}`}></span>)}
          </div>
          <span class="scope-sweep"></span>
        </div>
        <div class="scope-scale" aria-hidden="true">{scale.map((s) => <span>{s}</span>)}</div>
        <p class="scope-caption">{t(L, 'home.scopeCaption')}</p>
      </div>
    </div>

    <div class="ticker" data-ticker>
      <div class="ticker-track" data-ticker-track>
        <div class="ticker-copy">
          {tickerItems.map((item) => <span class="ticker-item"><b>GL</b>{item}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--border" aria-labelledby="pillars-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t(L, 'home.pillarsEyebrow')}</span>
          <h2 class="h2" id="pillars-heading" style="margin-top:1rem">{t(L, 'home.pillarsTitle')}</h2>
          <p class="lede" style="margin-top:1rem">{t(L, 'home.pillarsNote')}</p>
        </div>
      </div>
      <div class="pillar-grid">
        {pillars.map((pillar, i) => (
          <a class="pillar" href={pillar.href} data-reveal style={`--delay:${i * 70}ms`}>
            <span class="pillar-label">{pillar.label}</span>
            <span class="pillar-title">{pillar.title}</span>
            <span class="pillar-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cat-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t(L, 'home.categoriesEyebrow')}</span>
          <h2 class="h2" id="cat-heading" style="margin-top:1rem">{t(L, 'home.categoriesTitle')}</h2>
          <p class="lede" style="margin-top:1rem">{t(L, 'home.categoriesNote')}</p>
        </div>
        <a class="text-link" href={localePath(L, 'blog')}>{t(L, 'nav.discoverAll')} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="tiles">
        {CATEGORIES.map((category) => <CategoryTile category={category} lang={L} count={categoryCounts[category.slug] ?? 0} />)}
      </div>
    </div>
  </section>

  <section class="section section--border" aria-labelledby="logbook-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t(L, 'home.proofEyebrow')}</span>
          <h2 class="h2" id="logbook-heading" style="margin-top:1rem">{t(L, 'home.proofTitle')}</h2>
          <p class="lede" style="margin-top:1rem">{t(L, 'home.proofBody')}</p>
        </div>
      </div>
      <div class="proof-grid">
        {records.map((item, i) => (
          <div class="proof-item" data-reveal style={`--delay:${i * 70}ms`}>
            <span class="proof-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="proof-num" data-count={item.value} data-suffix={item.suffix || undefined}>{formatNum(item.value)}{item.suffix}</span>
            <div>
              <p class="proof-title">{item.title}</p>
              <p class="proof-text">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container note-block">
    <div class="note-side" data-reveal>
      <span class="eyebrow">{t(L, 'home.quoteEyebrow')}</span>
      <p class="note-meta"><span>{t(L, 'home.quoteMeta')}</span></p>
    </div>
    <div data-reveal style="--delay:120ms">
      <blockquote class="note-quote">{t(L, 'home.quote')}</blockquote>
      <p class="note-by"><span class="note-rule" aria-hidden="true"></span>{t(L, 'home.quoteBy')}</p>
    </div>
  </div>

  <section class="section section--border" aria-labelledby="series-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t(L, 'home.seriesEyebrow')}</span>
          <h2 class="h2" id="series-heading" style="margin-top:1rem">{t(L, 'home.seriesTitle')}</h2>
        </div>
        <a class="text-link" href={localePath(L, 'systems')}>{t(L, 'nav.systems')} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="series-grid">
        {SERIES.map((s, i) => <SeriesCard series={s} lang={L} count={seriesCounts[s.slug] ?? 0} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section section--border" aria-labelledby="latest-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t(L, 'home.latestEyebrow')}</span>
          <h2 class="h2" id="latest-heading" style="margin-top:1rem">{t(L, 'home.latestTitle')}</h2>
        </div>
        <a class="text-link" href={localePath(L, 'blog')}>{t(L, 'common.all')} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="latest-layout">
        <div class="latest-feature">{latest[0] && <ArticleCard card={latest[0]} lang={L} variant="feature" />}</div>
        <div class="latest-list">
          {latest.slice(1, 6).map((card, i) => <ArticleCard card={card} lang={L} variant="row" number={i + 2} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div data-reveal>
        <span class="eyebrow">{t(L, 'footer.stayCurrent')}</span>
        <h2 class="h2" style="margin-top:1rem">{t(L, 'home.ctaTitle')}</h2>
      </div>
      <div data-reveal style="--delay:120ms">
        <p class="lede">{t(L, 'home.ctaBody')}</p>
        <a class="btn btn--primary" href="#footer" style="margin-top:1.5rem">
          {t(L, 'home.ctaButton')} <span class="arrow">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
