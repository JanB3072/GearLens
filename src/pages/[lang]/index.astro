---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { CATEGORIES } from '../../config/navigation';
import { categoryPath, localePath, localeStaticParams } from '../../i18n';
import { pageAlternates } from '../../lib/links';
import { listByDate } from '../../lib/repository';
import { graph, itemListSchema, organizationSchema, websiteSchema } from '../../lib/schema';

export function getStaticPaths() {
  return localeStaticParams();
}

const { lang } = Astro.params;
const L = lang ?? 'en';
const all = listByDate(1, 50).cards;
const catShort = (slug: string) => CATEGORIES.find((c) => c.slug === slug)?.shortName ?? '';

const jsonLd = graph([
  organizationSchema(),
  websiteSchema(L),
  itemListSchema(all.slice(0, 6), `${SITE.name} latest guides`),
]);

const pickSlugs = ['home-theater-speaker-placement', 'small-room-5-1-2-system-plan'];
const editorPicks = pickSlugs
  .map((s) => all.find((c) => c.slug === s))
  .filter((c): c is (typeof all)[number] => Boolean(c));
const fresh = all.filter((c) => !editorPicks.includes(c)).slice(0, 3);

const clusters = CATEGORIES.slice(0, 4).map((cat) => {
  const arts = all.filter((a) => a.category === cat.slug);
  return {
    cat,
    main: arts[0],
    pair: arts.slice(1, 3),
    radar: arts.slice(0, 3),
  };
});
---

<BaseLayout
  lang={L}
  seo={{
    title: SITE.tagline,
    description: SITE.description,
    path: localePath(L),
    lang: L,
    alternates: pageAlternates(L),
    jsonLd,
    noappend: false,
  }}
>
  <div class="wrap">
    <div class="introline">
      <span>An independent audio journal</span>
      <span>Sound, planned as a system.</span>
    </div>

    <section class="home-intro">
      <h1>High-end audio, planned as a system.</h1>
      <p>Practical home theater, Hi-Fi and room-treatment guides for real rooms.</p>
    </section>

    <section class="hero" aria-label="Featured stories">
      {editorPicks.map((card, i) => (
        <article class:list={['feature', i === 1 && 'secondary']}>
          <a class="hero-photo" href={card.path} aria-label={card.title}>
            <img src="/placeholder.svg" alt="" width="1600" height="1067" decoding="async" />
          </a>
          <div class="caption">
            <a class="eyebrow" href={categoryPath(L, card.category)}>{catShort(card.category)} / The everyday edit</a>
            <h2><a href={card.path}>{card.title}</a></h2>
            <div class="meta">SoundAndRoom Editors · {card.readingMinutes} min read</div>
          </div>
        </article>
      ))}
    </section>

    <section class="latest">
      <div class="sectionlabel">Fresh notes <span class="eyebrow">/ 01</span></div>
      <div class="cards">
        {fresh.map((card) => (
          <article class="card">
            <a class="image" href={card.path} aria-label={card.title}>
              <img src="/placeholder.svg" alt="" width="1600" height="1067" decoding="async" loading="lazy" />
            </a>
            <div class="categoryline eyebrow">
              <a href={categoryPath(L, card.category)}>{catShort(card.category)}</a>
              <span>—</span>
              <span>{card.readingMinutes} min read</span>
            </div>
            <h3><a href={card.path}>{card.title}</a></h3>
            <div class="meta">SoundAndRoom Editors · {card.readingMinutes} min read</div>
          </article>
        ))}
      </div>
    </section>

    <aside class="notebanner">
      <div>
        <span class="eyebrow">The SoundAndRoom philosophy</span>
        <h2>A considered system. A little everyday joy in the listening room.</h2>
        <p>We plan the room, the channel layout and the signal chain before touching a price tag. Every guide carries a dated short answer, the measurements that backed it, and the part that did not work.</p>
      </div>
      <a class="arrowlink" href={localePath(L, 'about')}>Meet SoundAndRoom ↗</a>
    </aside>

    {clusters.map(({ cat, main, pair, radar }) => (
      <section class="topic">
        <h2>{cat.name}</h2>
        <p class="dek">{cat.description}</p>
        <div class="topicgrid">
          {main && (
            <div class="topic-main">
              <article class="card">
                <a class="image" href={main.path} aria-label={main.title}>
                  <img src="/placeholder.svg" alt="" width="1600" height="1067" decoding="async" loading="lazy" />
                </a>
                <div class="categoryline eyebrow">
                  <a href={categoryPath(L, main.category)}>{catShort(main.category)}</a>
                  <span>—</span>
                  <span>{main.readingMinutes} min read</span>
                </div>
                <h3><a href={main.path}>{main.title}</a></h3>
                <div class="meta">SoundAndRoom Editors · {main.readingMinutes} min read</div>
              </article>
            </div>
          )}
          <div class="topic-pair">
            {pair.map((card) => (
              <article class="card">
                <a class="image" href={card.path} aria-label={card.title}>
                  <img src="/placeholder.svg" alt="" width="1600" height="1067" decoding="async" loading="lazy" />
                </a>
                <div class="categoryline eyebrow">
                  <a href={categoryPath(L, card.category)}>{catShort(card.category)}</a>
                  <span>—</span>
                  <span>{card.readingMinutes} min read</span>
                </div>
                <h3><a href={card.path}>{card.title}</a></h3>
                <div class="meta">SoundAndRoom Editors · {card.readingMinutes} min read</div>
              </article>
            ))}
          </div>
          <aside class="topstories">
            <h3>On our radar</h3>
            {radar.map((card, i) => (
              <a class="topstory" href={card.path}>
                <span>{String(i + 1).padStart(2, '0')} / {catShort(card.category).toUpperCase()}</span>
                <p>{card.title}</p>
              </a>
            ))}
          </aside>
        </div>
        <a class="more" href={categoryPath(L, cat.slug)}>Explore {cat.name} ↗</a>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .introline {
    display: flex; justify-content: space-between; align-items: center;
    border-top: 1px solid var(--line); padding: 14px 0 21px;
    font-size: 10px; letter-spacing: 1.8px; text-transform: uppercase; color: var(--muted);
  }
  .home-intro { padding: 0 0 28px; }
  .home-intro h1 { font: 500 30px/1.3 var(--serif); margin: 0 0 9px; color: var(--ink); }
  .home-intro p { font-size: 13px; color: var(--muted); margin: 0; }

  .hero { display: grid; grid-template-columns: 1.45fr 1fr; gap: 34px; padding-bottom: 55px; }
  .feature { position: relative; padding-bottom: 25px; }
  .feature img { height: 570px; width: 100%; object-fit: cover; }
  .feature.secondary { padding-top: 65px; }
  .feature.secondary img { height: 390px; }
  .hero-photo { overflow: hidden; display: block; }
  .feature img, .card img { transition: transform .6s; }
  .feature:hover img, .card:hover img { transform: scale(1.025); }
  .feature .caption {
    position: relative; margin: -110px 0 0 40px; padding: 29px 35px 28px;
    background: var(--sage); color: #fff; max-width: calc(100% - 40px); z-index: 1;
  }
  .feature.secondary .caption {
    background: var(--rose); margin-top: -66px; margin-left: 31px; max-width: calc(100% - 18px);
  }
  .feature h2 {
    font-family: var(--sans); font-size: 23px; line-height: 1.35; font-weight: 400;
    letter-spacing: .4px; text-transform: uppercase; margin: 13px 0 22px;
  }
  .feature h2 a { color: #fff; }
  .feature.secondary h2 { font-size: 20px; }
  .meta { font-size: 10px; letter-spacing: 1px; line-height: 1.7; text-transform: uppercase; }
  .feature .meta { color: #f5f5ef; }

  .sectionlabel {
    font-size: 12px; text-transform: uppercase; letter-spacing: 3px;
    display: flex; gap: 16px; align-items: center; margin-bottom: 25px; color: var(--ink);
  }
  .sectionlabel:after { content: ''; height: 1px; background: var(--line); flex: 1; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .card .image { overflow: hidden; margin-bottom: 18px; display: block; }
  .card img { aspect-ratio: 1.48; height: auto; width: 100%; object-fit: cover; }
  .card h3 {
    font-family: var(--sans); font-size: 18px; line-height: 1.45; font-weight: 500;
    text-transform: uppercase; letter-spacing: .3px; margin: 9px 0 12px;
  }
  .card h3 a { color: var(--ink); }
  .card .meta { color: var(--muted); font-size: 9px; }
  .categoryline {
    display: flex; gap: 10px; align-items: center; color: var(--sage);
    font-size: 10px; letter-spacing: 1px; text-transform: uppercase;
  }
  .categoryline a { color: var(--sage); }
  .latest { padding-bottom: 75px; }

  .notebanner {
    margin: 10px 0 75px; padding: 30px 45px; background: #e6eadf;
    display: flex; align-items: center; justify-content: space-between; gap: 30px;
  }
  .notebanner h2 { font: 500 30px/1.3 var(--serif); margin: 7px 0; color: var(--ink); }
  .notebanner p { font-size: 13px; color: var(--muted); margin: 10px 0; }
  .arrowlink {
    font-size: 11px; letter-spacing: 1.6px; text-transform: uppercase;
    white-space: nowrap; color: var(--ink);
  }

  .topic { padding: 0 0 70px; }
  .topic > h2 {
    font-family: var(--sans); font-size: 27px; font-weight: 500; text-transform: uppercase;
    letter-spacing: 8px; margin: 0 0 10px; color: var(--ink);
  }
  .topic > .dek { color: var(--muted); font-size: 14px; margin: 0 0 32px; }
  .topicgrid { display: grid; grid-template-columns: 1.3fr 1fr .88fr; gap: 30px; }
  .topic-main img { aspect-ratio: .94; width: 100%; object-fit: cover; }
  .topic-main h3 {
    font-family: var(--sans); font-size: 24px; text-transform: uppercase;
    letter-spacing: .3px; margin: 9px 0 12px;
  }
  .topic-main h3 a { color: var(--ink); }
  .topic-pair { display: grid; gap: 26px; }
  .topic-pair .card img { aspect-ratio: 1.8; }
  .topic-pair h3 { font-size: 15px; }
  .topstories { padding: 0 0 0 22px; border-left: 1px solid var(--line); }
  .topstories h3 { font: 500 25px var(--serif); margin: 0 0 16px; color: var(--ink); }
  .topstory { display: block; padding: 18px 0; border-bottom: 1px solid var(--line); color: var(--ink); }
  .topstory span { font-size: 9px; color: var(--sage); letter-spacing: 1px; }
  .topstory p { font-size: 13px; line-height: 1.6; margin: 6px 0 0; text-transform: uppercase; }
  .topic .more {
    margin-top: 30px; border: 1px solid var(--ink); display: inline-block;
    padding: 12px 25px; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--ink);
  }

  @media (min-width: 1450px) {
    .feature img { height: 620px; }
    .feature.secondary img { height: 430px; }
  }
  @media (max-width: 1100px) {
    .hero { gap: 25px; }
    .feature img { height: 470px; }
    .feature.secondary img { height: 340px; }
    .feature .caption { margin-left: 25px; padding: 24px; max-width: calc(100% - 25px); }
    .topicgrid { grid-template-columns: 1.2fr 1fr; }
    .topstories { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; border: 0; padding: 0; }
    .topstories h3 { grid-column: 1 / -1; margin: 0; }
    .topstory { padding: 12px 0; }
  }
  @media (max-width: 760px) {
    .introline { font-size: 8px; letter-spacing: 1px; }
    .hero { grid-template-columns: 1fr; gap: 10px; padding-bottom: 35px; }
    .feature img { height: auto; aspect-ratio: 1.05; }
    .feature.secondary { padding-top: 0; }
    .feature.secondary img { height: auto; aspect-ratio: 1.4; }
    .feature .caption, .feature.secondary .caption { margin: -70px 0 0 22px; padding: 23px; max-width: calc(100% - 22px); }
    .feature h2 { font-size: 21px; }
    .feature.secondary h2 { font-size: 19px; }
    .cards { grid-template-columns: 1fr; gap: 30px; }
    .latest { padding-bottom: 45px; }
    .latest .cards { grid-template-columns: 1fr 1fr; gap: 20px; }
    .latest .card:first-child { grid-column: 1 / -1; }
    .latest .card:not(:first-child) h3 { font-size: 14px; }
    .card h3 { font-size: 17px; }
    .notebanner { padding: 28px; display: block; margin-bottom: 50px; }
    .notebanner h2 { font-size: 27px; }
    .notebanner .arrowlink { display: block; margin-top: 20px; }
    .topic { padding-bottom: 45px; }
    .topic > h2 { font-size: 23px; letter-spacing: 5px; }
    .topicgrid { grid-template-columns: 1fr; }
    .topic-main img { aspect-ratio: 1.4; }
    .topic-pair { grid-template-columns: 1fr 1fr; gap: 20px; }
    .topic-pair .card img { aspect-ratio: 1.2; }
    .topic-pair h3 { font-size: 13px; }
    .topstories { grid-template-columns: 1fr; gap: 0; }
    .topstories h3 { font-size: 24px; }
    .topstory { padding: 14px 0; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
