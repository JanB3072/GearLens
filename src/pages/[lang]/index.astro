---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesCard from '../../components/cards/SeriesCard.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { SITE } from '../../config/site';
import { CATEGORIES, SERIES } from '../../config/navigation';
import { categoryPath, localePath, localeStaticParams, t } from '../../i18n';
import { pageAlternates } from '../../lib/links';
import { getGroupCounts, getStats, listByDate } from '../../lib/repository';
import { graph, itemListSchema, organizationSchema, websiteSchema } from '../../lib/schema';

export function getStaticPaths() {
  return localeStaticParams();
}

const { lang } = Astro.params;
const L = lang ?? 'en';
const all = listByDate(1, 50).cards;
const categoryCounts = getGroupCounts('by-category');
const seriesCounts = getGroupCounts('by-series');
const stats = getStats() as { published: number; words: number; categories: Record<string, number> };

const jsonLd = graph([
  organizationSchema(),
  websiteSchema(L),
  itemListSchema(all.slice(0, 6), `${SITE.name} latest guides`),
]);

const numberFormat = new Intl.NumberFormat(L === 'de' ? 'de-DE' : 'en-US');
const formatNum = (n: number) => numberFormat.format(n);
const lastEdit = all[0]?.updatedAt
  ? new Intl.DateTimeFormat(L === 'de' ? 'de-DE' : 'en-US', {
      month: 'short', day: 'numeric', timeZone: 'UTC',
    }).format(new Date(all[0].updatedAt))
  : 'n/a';

const pickSlugs = ['home-theater-speaker-placement', 'small-room-5-1-2-system-plan'];
const editorPicks = pickSlugs
  .map((s) => all.find((c) => c.slug === s))
  .filter((c): c is (typeof all)[number] => Boolean(c));
const fresh = all.filter((c) => !editorPicks.includes(c)).slice(0, 3);

const clusters = CATEGORIES.map((cat) => {
  const arts = all.filter((a) => a.category === cat.slug).slice(0, 3);
  const radar = (arts.filter((a) => a.pillar).length ? arts.filter((a) => a.pillar) : arts).slice(0, 3);
  return { cat, arts, radar };
});

// A deterministic in-room response shape: two room-mode dips, a gentle HF
// roll-off and small ripples. Same markup on every build, no random jumps.
const BAR_COUNT = 48;
const bars = Array.from({ length: BAR_COUNT }, (_, i) => {
  const x = i / (BAR_COUNT - 1);
  const ripple = Math.sin(x * Math.PI * 5) * 12 + Math.sin(x * Math.PI * 13) * 7;
  const tilt = 74 - x * 18;
  const d1 = (x - 0.32) / 0.05;
  const d2 = (x - 0.68) / 0.055;
  const dip = 30 * Math.exp(-(d1 * d1)) + 20 * Math.exp(-(d2 * d2));
  return Math.round(Math.max(10, Math.min(96, tilt + ripple - dip)));
});

const tickerItems = [
  `${t(L, 'home.tickerLatest')}: ${all[0]?.title ?? SITE.name}`,
  `${formatNum(stats.published)} ${t(L, 'home.tickerGuides')}`,
  `${t(L, 'home.tickerMirrors')}`,
  `© ${new Date().getFullYear()} ${SITE.organization}`,
];
const scale = ['20', '50', '100', '200', '500', '1k', '2k', '5k', '10k', '20k'];
---

<BaseLayout
  lang={L}
  seo={{
    title: SITE.tagline,
    description: SITE.description,
    path: localePath(L),
    lang: L,
    alternates: pageAlternates(L),
    jsonLd,
    noappend: false,
  }}
>
  <section class="hero" data-glow>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">{t(L, 'home.heroEyebrow')}</span>
        <h1 class="display" data-hero-lines>
          <span class="hero-line" style="--line:0"><span>{t(L, 'home.heroTitleA')}</span></span>
          <span class="hero-line" style="--line:1"><span><em>{t(L, 'home.heroTitleB')}</em></span></span>
        </h1>
        <p class="lede">{t(L, 'home.heroBody')}</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href={localePath(L, 'systems')}>{t(L, 'home.heroPrimary')} <span class="arrow">↗</span></a>
          <a class="btn btn--ghost" href={localePath(L, 'blog')}>{t(L, 'home.heroSecondary')}</a>
        </div>
        <div class="hero-meta">
          <div><strong data-count={stats.published}>{formatNum(stats.published)}</strong><small>{t(L, 'home.recordGuides')}</small></div>
          <div><strong data-count={CATEGORIES.length}>{formatNum(CATEGORIES.length)}</strong><small>{t(L, 'nav.categories')}</small></div>
          <div><strong>{lastEdit}</strong><small>{t(L, 'article.updated')}</small></div>
        </div>
      </div>

      <div class="hero-scope">
        <div class="scope-head">
          <span>{t(L, 'home.scopeLabel')}</span>
          <span class="scope-dot" aria-hidden="true"></span>
        </div>
        <div class="scope-plot" aria-hidden="true">
          <div class="scope-bars">
            {bars.map((h, i) => <span class="scope-bar" style={`--h:${h}%;--i:${i}`}></span>)}
          </div>
          <span class="scope-sweep"></span>
        </div>
        <div class="scope-scale" aria-hidden="true">{scale.map((s) => <span>{s}</span>)}</div>
        <p class="scope-caption">{t(L, 'home.scopeCaption')}</p>
      </div>
    </div>

    <div class="ticker" data-ticker>
      <div class="ticker-track" data-ticker-track>
        <div class="ticker-copy">
          {tickerItems.map((item) => <span class="ticker-item"><b>GL</b>{item}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--border" aria-labelledby="edit-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t(L, 'home.everydayEdit')}</span>
          <h2 class="h2" id="edit-heading" style="margin-top:1rem">{t(L, 'home.everydayEditNote')}</h2>
        </div>
        <a class="text-link" href={localePath(L, 'systems')}>{t(L, 'nav.systems')} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="everyday-grid">
        {editorPicks.map((card) => <ArticleCard card={card} lang={L} variant="feature" />)}
      </div>
    </div>
  </section>

  <section class="section fresh-notes" aria-labelledby="fresh-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t(L, 'home.freshNotes')} / {t(L, 'home.freshNotesIndex')}</span>
          <h2 class="h2" id="fresh-heading" style="margin-top:1rem">{t(L, 'home.latestTitle')}</h2>
        </div>
        <a class="text-link" href={localePath(L, 'blog')}>{t(L, 'home.allStories')} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="article-grid">
        {fresh.map((card) => <ArticleCard card={card} lang={L} variant="default" />)}
      </div>
    </div>
  </section>

  <section class="philosophy" aria-labelledby="philosophy-heading">
    <div class="container philosophy-inner">
      <span class="eyebrow">{t(L, 'home.philosophyEyebrow')}</span>
      <h2 class="h2" id="philosophy-heading">{t(L, 'home.philosophyTitle')}</h2>
      <p class="lede">{t(L, 'home.philosophyBody')}</p>
      <a class="btn btn--ghost" href={localePath(L, 'about')}>{t(L, 'home.philosophyLink')} <span class="arrow">↗</span></a>
    </div>
  </section>

  <section class="section section--border" aria-labelledby="clusters-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t(L, 'home.categoriesEyebrow')}</span>
          <h2 class="h2" id="clusters-heading" style="margin-top:1rem">{t(L, 'nav.categories')}</h2>
          <p class="lede" style="margin-top:1rem">{t(L, 'home.clusterNote')}</p>
        </div>
        <a class="text-link" href={localePath(L, 'blog')}>{t(L, 'home.allStories')} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="clusters">
        {clusters.map(({ cat, arts, radar }) => (
          <div class="cluster" data-reveal>
            <div class="cluster-head">
              <h3 class="cluster-title"><a href={categoryPath(L, cat.slug)}>{cat.name}</a></h3>
              <span class="cluster-count">{categoryCounts[cat.slug] ?? 0} {t(L, 'listing.articles')}</span>
            </div>
            <p class="cluster-desc">{cat.description}</p>
            <ul class="cluster-links">
              {arts.map((a) => (
                <li><a href={a.path}>{a.title} <span class="cluster-read">{a.readingMinutes} {t(L, 'common.minRead')}</span></a></li>
              ))}
            </ul>
            <div class="cluster-radar">
              <span class="cluster-radar-label">{t(L, 'home.onRadar')}</span>
              <ol>
                {radar.map((a, i) => (
                  <li><span class="radar-num">{String(i + 1).padStart(2, '0')}</span> <a href={a.path}>{a.title}</a></li>
                ))}
              </ol>
            </div>
            <a class="text-link" href={categoryPath(L, cat.slug)}>{t(L, 'home.explore')} {cat.name} <span aria-hidden="true">↗</span></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--border" aria-labelledby="series-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{t(L, 'home.seriesEyebrow')}</span>
          <h2 class="h2" id="series-heading" style="margin-top:1rem">{t(L, 'home.seriesTitle')}</h2>
          <p class="lede" style="margin-top:1rem">{t(L, 'home.buildPathsIntro')}</p>
        </div>
        <a class="text-link" href={localePath(L, 'systems')}>{t(L, 'nav.systems')} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="series-grid">
        {SERIES.map((s, i) => <SeriesCard series={s} lang={L} count={seriesCounts[s.slug] ?? 0} index={i} />)}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div data-reveal>
        <span class="eyebrow">{t(L, 'footer.stayCurrent')}</span>
        <h2 class="h2" style="margin-top:1rem">{t(L, 'home.ctaTitle')}</h2>
      </div>
      <div data-reveal style="--delay:120ms">
        <p class="lede">{t(L, 'home.ctaBody')}</p>
        <a class="btn btn--primary" href="#footer" style="margin-top:1.5rem">
          {t(L, 'home.ctaButton')} <span class="arrow">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
