---
import { SITE } from '../../config/site';
import { CATEGORIES } from '../../config/navigation';
import { categoryPath, localePath, t } from '../../i18n';

interface Props { lang: string }
const { lang } = Astro.props;
const topCategories = CATEGORIES.slice(0, 4);
---

<footer class="footer">
  <div class="wrap">
    <div class="footgrid">
      <div>
        <a class="brand" href={localePath(lang)} aria-label={SITE.name}>
          <img class="brand-logo" src="/logo.png" alt={SITE.name} />
        </a>
        <p>{t(lang, 'footer.tagline')}</p>
      </div>

      <div>
        <h3>{t(lang, 'footer.explore')}</h3>
        <div class="links">
          {topCategories.map((cat) => (
            <a href={categoryPath(lang, cat.slug)}>{cat.name}</a>
          ))}
          <a href={localePath(lang, 'blog')}>{t(lang, 'listing.latest')}</a>
        </div>
      </div>

      <div>
        <h3>{t(lang, 'footer.publication')}</h3>
        <div class="links">
          <a href={localePath(lang, 'about')}>{t(lang, 'nav.about')}</a>
          <a href={`mailto:${SITE.email}`}>{t(lang, 'nav.contact')}</a>
          <a href={localePath(lang, 'editorial-policy')}>{t(lang, 'nav.standards')}</a>
          <a href={localePath(lang, 'privacy')}>{t(lang, 'nav.privacy')}</a>
        </div>
      </div>

      <div>
        <h3>{t(lang, 'footer.details')}</h3>
        <div class="links">
          <a href="/llms.txt">llms.txt</a>
          <a href="/sitemap.xml">Sitemap</a>
          <a href="/feed.xml">RSS feed</a>
          <a href={localePath(lang, 'search')}>{t(lang, 'nav.search')}</a>
        </div>
        <p>{t(lang, 'footer.writeEditors')} <a href={`mailto:${SITE.email}`}>{t(lang, 'footer.writeLink')} ↗</a></p>
      </div>
    </div>

    <div class="copyright">
      <span>© {new Date().getFullYear()} {SITE.organization}. {t(lang, 'footer.rights')}</span>
      <span>{t(lang, 'footer.independent')}</span>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding: 45px 0 25px; background: #eaece4; }
  .footgrid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.3fr; gap: 45px; }
  .footer .brand { display: flex; align-items: center; gap: 9px; text-decoration: none !important; }
  .footer .brand-logo { height: 34px; width: auto; }
  .footer h3 { font: 500 21px var(--serif); margin: 0 0 18px; }
  .footer p { font-size: 12px; line-height: 1.8; color: var(--muted); }
  .footer .links { display: grid; gap: 13px; font-size: 10px; letter-spacing: 1px; text-transform: uppercase; }
  .footer .links a { color: var(--ink); }
  .copyright {
    margin-top: 40px; border-top: 1px solid #cbd2c4; padding-top: 20px;
    display: flex; justify-content: space-between; font-size: 9px; letter-spacing: 1px; text-transform: uppercase;
  }

  @media (max-width: 1100px) { .footgrid { gap: 25px; } }
  @media (max-width: 760px) {
    .footgrid { grid-template-columns: 1fr 1fr; gap: 35px 22px; }
    .footgrid > div:first-child { grid-column: 1 / -1; }
    .footer .brand-logo { height: 34px; }
    .footer h3 { font-size: 21px; }
    .copyright { display: block; line-height: 2.2; }
    .copyright span { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
