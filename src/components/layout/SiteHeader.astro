---
import { SITE } from '../../config/site';
import { getNavigation } from '../../config/navigation';
import { localePath, t } from '../../i18n';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props { lang: string; currentPath?: string }
const { lang, currentPath = '' } = Astro.props;
const nav = getNavigation(lang);
---

<header class="site-header" id="header">
  <div class="container header-inner">
    <a class="brand" href={localePath(lang)} aria-label={`${SITE.name} — ${t(lang, 'nav.home')}`}>
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <span class="brand-text">{SITE.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <div class="nav-item">
          <a class="nav-link" href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
            {item.label}{item.columns && <span class="caret" aria-hidden="true">▾</span>}
          </a>
          {item.columns && (
            <div class="mega">
              <div class="mega-inner">
                {item.columns.map((col) => (
                  <div>
                    <p class="mega-title">{col.title}</p>
                    <ul class="mega-links">
                      {col.links.map((link) => (
                        <li><a class="mega-link" href={link.href}>{link.label}{link.hint && <span class="mega-hint">{link.hint}</span>}</a></li>
                      ))}
                    </ul>
                  </div>
                ))}
                {item.feature && (
                  <div class="mega-feature">
                    <span class="eyebrow">{item.feature.eyebrow}</span>
                    <h4>{item.feature.title}</h4>
                    <p>{item.feature.body}</p>
                    <a href={item.feature.href}>{t(lang, 'nav.discoverAll')} →</a>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="header-actions">
      <a class="icon-btn" href={localePath(lang, 'search')} aria-label={t(lang, 'nav.search')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path>
        </svg>
      </a>
      <LocaleSwitcher lang={lang} />
      <button class="icon-btn nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-label={t(lang, 'nav.menu')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 7h18M3 12h18M3 17h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav" data-mobile-nav hidden>
    <nav class="container" aria-label="Mobile">
      {nav.map((item) => (
        <details>
          <summary>{item.label}</summary>
          <ul>
            <li><a href={item.href}>{t(lang, 'common.all')}</a></li>
            {(item.columns ?? []).flatMap((c) => c.links).map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </details>
      ))}
      <details>
        <summary>{t(lang, 'nav.about')}</summary>
        <ul>
          <li><a href={localePath(lang, 'about')}>{t(lang, 'nav.about')}</a></li>
          <li><a href={localePath(lang, 'glossary')}>{t(lang, 'nav.glossary')}</a></li>
        </ul>
      </details>
    </nav>
  </div>
</header>
