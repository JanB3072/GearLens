---
import { t } from '../../i18n';

interface Props {
  page: number;
  totalPages: number;
  lang: string;
  /** Receives a 1-based page number, returns a relative URL. */
  href: (page: number) => string;
}
const { page, totalPages, lang, href } = Astro.props;

const window_: number[] = [];
const from = Math.max(1, Math.min(page - 2, totalPages - 4));
const to = Math.min(totalPages, Math.max(page + 2, 5));
for (let i = from; i <= to; i++) window_.push(i);
const shown = window_.filter((n) => n >= 1 && n <= totalPages);
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {page > 1 && <a class="page-link" href={href(page - 1)} rel="prev">← {t(lang, 'listing.prev')}</a>}
    {shown[0] > 1 && <><a class="page-link" href={href(1)}>1</a><span class="page-ellipsis">…</span></>}
    {shown.map((n) => n === page
      ? <span class="page-current" aria-current="page">{n}</span>
      : <a class="page-link" href={href(n)}>{n}</a>)}
    {shown[shown.length - 1] < totalPages && <><span class="page-ellipsis">…</span><a class="page-link" href={href(totalPages)}>{totalPages}</a></>}
    {page < totalPages && <a class="page-link" href={href(page + 1)} rel="next">{t(lang, 'listing.next')} →</a>}
  </nav>
)}
