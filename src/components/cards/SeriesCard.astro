---
import { localePath, t } from '../../i18n';
import type { Series } from '../../lib/types';
interface Props { series: Series; lang: string; count?: number; index?: number }
const { series, lang, count, index = 0 } = Astro.props;
---
<a class="series-card" href={localePath(lang, 'series', series.slug)} data-reveal style={`--delay:${index * 80}ms`}>
  <span class="series-index">{String(index + 1).padStart(2, '0')}</span>
  <span>
    <span class="series-eyebrow">{series.eyebrow}</span>
    <span class="series-title">{series.name}</span>
    <span class="series-body">{series.description}</span>
  </span>
  <span class="series-count">{count ?? series.articleCount}<small>{t(lang, 'listing.articles')}</small></span>
  <span class="series-arrow" aria-hidden="true">↗</span>
</a>
