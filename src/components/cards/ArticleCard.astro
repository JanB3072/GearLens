---
import { formatDate, t } from '../../i18n';
import { categoryBySlug, authorBySlug } from '../../lib/taxonomy';
import type { ArticleCard as Card } from '../../lib/types';

interface Props { card: Card; lang: string }
const { card, lang } = Astro.props;
const category = categoryBySlug.get(card.category);
const author = authorBySlug.get(card.author);
---

<article class="article-card">
  <a class="article-card-media" href={card.path} tabindex="-1" aria-hidden="true">
    {card.heroImage
      ? <img src={card.heroImage} alt="" loading="lazy" decoding="async" width="640" height="360" />
      : <span class="visually-hidden">Article illustration</span>}
  </a>
  <div class="article-card-body">
    <div class="article-card-meta">
      {card.pillar && <span class="badge badge--pillar">Hub guide</span>}
      <span>{category?.shortName ?? card.category}</span>
      <span aria-hidden="true">·</span>
      <time datetime={card.updatedAt}>{formatDate(card.updatedAt, lang)}</time>
    </div>
    <h3 class="article-card-title"><a href={card.path}>{card.title}</a></h3>
    <p class="article-card-desc">{card.description}</p>
    <div class="article-card-foot">
      <span>{author?.name ?? card.author}</span>
      <span>{card.readingMinutes} {t(lang, 'common.minRead')}</span>
    </div>
  </div>
</article>
